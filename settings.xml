<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven settings template for publishing platform-shared-contracts to
    GitHub Packages.

    HOW TO USE
    ==========
    1. Copy this file to ~/.m2/settings.xml. If you already have a settings.xml,
       merge the <servers> entry below into the existing <servers> block.
    2. Export the two environment variables this file references:

         export GITHUB_USERNAME="<your GitHub login>"
         export GITHUB_TOKEN="<a PAT with read:packages + write:packages>"

       In CI, prefer the built-in GITHUB_TOKEN secret (no read scope required
       for the org's own packages).
    3. Uncomment the <distributionManagement> block in the parent pom.xml and
       run:

         mvn -B -DskipTests deploy

    Server id "github" must match the id declared in <distributionManagement>.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_USERNAME}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>

</settings>
