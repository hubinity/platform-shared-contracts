{
  "name": "@hubinity/tailwind-preset",
  "version": "0.1.0",
  "description": "Shared Tailwind CSS 4 design tokens for the Hubinity multi-frontend ecosystem (HiBit + Star Coffee).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./theme.totem.css": "./dist/theme.totem.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && cp src/theme.css dist/ && cp src/theme.totem.css dist/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "sideEffects": false,
  "keywords": [
    "tailwind",
    "tailwindcss",
    "preset",
    "design-tokens",
    "hubinity"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hubinity/platform-shared-contracts.git",
    "directory": "tailwind-preset"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
