<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hubinity</groupId>
    <artifactId>platform-shared-contracts</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Hubinity :: Platform Shared Contracts</name>
    <description>
        Single source of truth for Hubinity cross-service API contracts (OpenAPI 3.1)
        and event payload schemas (JSON Schema 2020-12). Each sub-module generates
        Jackson-annotated Java DTOs consumed by the backend services.
    </description>

    <modules>
        <module>contracts-catalog</module>
        <module>contracts-order</module>
        <module>contracts-support</module>
        <module>contracts-cashier</module>
        <module>contracts-events</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>

        <openapi-generator.version>7.13.0</openapi-generator.version>
        <jsonschema2pojo.version>1.2.2</jsonschema2pojo.version>
        <jackson.version>2.18.2</jackson.version>
        <swagger-parser.version>2.1.22</swagger-parser.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>

        <!--
            Compile-only annotation jars required to satisfy imports emitted by
            openapi-generator's "spring" generator (used for DTO-only generation
            per ADR 0002). These are pure annotation/utility libraries; they do
            NOT pull a Spring runtime or a server framework into the contracts
            modules.
        -->
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
        <spring-core.version>6.2.1</spring-core.version>

        <!--
            Workaround for openapi-generator-maven-plugin URI parsing bug
            (https://github.com/OpenAPITools/openapi-generator/issues/XXXX):
            non-ASCII characters in the absolute path of <inputSpec> (e.g. the
            dev machine's "Área de Trabalho") trigger java.net.URISyntaxException
            because the plugin URI-parses the path. We copy the spec files to a
            scratch directory under java.io.tmpdir (always plain ASCII on Linux)
            and point <inputSpec> at the copy. See the antrun execution in
            <pluginManagement> below.
        -->
        <openapi.spec.staging.dir>${java.io.tmpdir}/hubinity-shared-contracts/${project.artifactId}/openapi</openapi.spec.staging.dir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-context</artifactId>
                <version>${spring-core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                    <configuration>
                        <generatorName>spring</generatorName>
                        <generateApis>false</generateApis>
                        <generateModels>true</generateModels>
                        <generateSupportingFiles>false</generateSupportingFiles>
                        <generateApiTests>false</generateApiTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelTests>false</generateModelTests>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        <output>${project.build.directory}/generated-sources/openapi</output>
                        <configOptions>
                            <useSpringBoot3>true</useSpringBoot3>
                            <interfaceOnly>true</interfaceOnly>
                            <useTags>true</useTags>
                            <skipDefaultInterface>true</skipDefaultInterface>
                            <useJakartaEe>true</useJakartaEe>
                            <dateLibrary>java8</dateLibrary>
                            <serializationLibrary>jackson</serializationLibrary>
                            <openApiNullable>false</openApiNullable>
                            <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            <useBeanValidation>false</useBeanValidation>
                            <performBeanValidation>false</performBeanValidation>
                            <documentationProvider>none</documentationProvider>
                            <annotationLibrary>none</annotationLibrary>
                            <sourceFolder>src/main/java</sourceFolder>
                        </configOptions>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jsonschema2pojo</groupId>
                    <artifactId>jsonschema2pojo-maven-plugin</artifactId>
                    <version>${jsonschema2pojo.version}</version>
                    <configuration>
                        <sourceType>jsonschema</sourceType>
                        <targetVersion>${java.version}</targetVersion>
                        <useJakartaValidation>true</useJakartaValidation>
                        <annotationStyle>jackson2</annotationStyle>
                        <includeJsr303Annotations>false</includeJsr303Annotations>
                        <includeAdditionalProperties>false</includeAdditionalProperties>
                        <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
                        <dateTimeType>java.time.OffsetDateTime</dateTimeType>
                        <useBigDecimals>true</useBigDecimals>
                        <initializeCollections>true</initializeCollections>
                        <useOptionalForGetters>false</useOptionalForGetters>
                        <generateBuilders>true</generateBuilders>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>copy-openapi-spec-to-ascii-path</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <mkdir dir="${openapi.spec.staging.dir}"/>
                                    <copy todir="${openapi.spec.staging.dir}" overwrite="true" failonerror="false">
                                        <fileset dir="${project.basedir}/openapi" erroronmissingdir="false">
                                            <include name="**/*.yaml"/>
                                            <include name="**/*.yml"/>
                                            <include name="**/*.json"/>
                                        </fileset>
                                    </copy>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>add-generated-sources</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>add-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
        GitHub Packages publishing (ADR 0010). CI/local environments must
        provide ${env.GITHUB_USERNAME} / ${env.GITHUB_TOKEN}; see ./settings.xml.
        Deploys are triggered by the publish-maven.yml workflow on `v*` tags.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>Hubinity Platform Shared Contracts</name>
            <url>https://maven.pkg.github.com/hubinity/platform-shared-contracts</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>Hubinity Platform Shared Contracts (snapshots)</name>
            <url>https://maven.pkg.github.com/hubinity/platform-shared-contracts</url>
        </snapshotRepository>
    </distributionManagement>
</project>
