{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/StockChanged.schema.json",
  "title": "StockChanged",
  "description": "Emitted by the Catalog service after a stock movement is applied. Consumed by any service that maintains a stock projection (e.g. Order, Totem, Cashier).",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.StockChanged",
  "required": [
    "eventId",
    "productId",
    "quantityDelta",
    "quantityOnHandAfter",
    "reason",
    "occurredAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "quantityDelta": {
      "type": "integer",
      "description": "Signed change in stock. Positive = inbound, negative = outbound."
    },
    "quantityOnHandAfter": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "enum": ["PURCHASE", "SALE", "ADJUSTMENT", "RETURN", "LOSS"]
    },
    "movementId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
