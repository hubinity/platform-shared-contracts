{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/ServiceRevenueGenerated.schema.json",
  "title": "ServiceRevenueGenerated",
  "description": "Emitted by the Support service when a service ticket is closed and produces billable revenue. Consumed by Cashier to book a ledger entry.",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.ServiceRevenueGenerated",
  "required": [
    "eventId",
    "ticketId",
    "amount",
    "occurredAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "technicianId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "BRL"
    },
    "ledgerCategoryHint": {
      "type": "string",
      "description": "Optional hint for the cashier ledger category name."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
