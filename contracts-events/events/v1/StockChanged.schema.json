{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/v1/StockChanged.schema.json",
  "title": "StockChanged",
  "description": "Emitted by the Catalog service after each stock mutation (IN, OUT, RESERVE, RELEASE, COMMIT). Carries a before/after snapshot of the available/reserved counters so consumers can maintain a stock projection without extra reads. Minor/patch evolution stays in this file via schemaVersion (ADR 0005); breaking changes go to a new events/vN/ path (ADR 0007).",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.v1.StockChanged",
  "required": [
    "eventId",
    "schemaVersion",
    "productId",
    "previousAvailable",
    "previousReserved",
    "available",
    "reserved",
    "changeType",
    "quantity",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "= messageId do outbox; chave de deduplicação at-least-once"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "previousAvailable": {
      "type": "integer",
      "minimum": 0,
      "description": "Available quantity before the mutation."
    },
    "previousReserved": {
      "type": "integer",
      "minimum": 0,
      "description": "Reserved quantity before the mutation."
    },
    "available": {
      "type": "integer",
      "minimum": 0,
      "description": "Available quantity after the mutation."
    },
    "reserved": {
      "type": "integer",
      "minimum": 0,
      "description": "Reserved quantity after the mutation."
    },
    "changeType": {
      "type": "string",
      "enum": ["IN", "OUT", "RESERVE", "RELEASE", "COMMIT"]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "Quantity moved by this mutation (always positive; direction is given by changeType)."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
