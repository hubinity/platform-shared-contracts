{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/v1/OrderCancelled.schema.json",
  "title": "OrderCancelled",
  "description": "Emitted by the Order service when an order is cancelled. Consumed by Catalog (release reservations) and Cashier (compensating ledger entry if already booked).",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.v1.OrderCancelled",
  "required": [
    "eventId",
    "orderId",
    "reason",
    "cancelledAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "description": "Free-form or coded cancellation reason."
    },
    "wasPaid": {
      "type": "boolean",
      "description": "True if the order had already reached PAID before cancellation; signals consumers that a compensating action is required.",
      "default": false
    },
    "refundAmount": {
      "type": "number",
      "minimum": 0
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
