{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/v1/ProductUpdated.schema.json",
  "title": "ProductUpdated",
  "description": "Emitted by the Catalog service when a product's metadata (name, description, category) changes. Price-only changes go through PriceChanged. Active/inactive toggle goes through ProductDeactivated.",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.v1.ProductUpdated",
  "required": [
    "eventId",
    "productId",
    "occurredAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "categoryId": {
      "type": "string",
      "format": "uuid"
    },
    "changedFields": {
      "type": "array",
      "description": "Names of the fields that actually changed in this update.",
      "items": {
        "type": "string"
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
