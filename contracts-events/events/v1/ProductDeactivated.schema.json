{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/v1/ProductDeactivated.schema.json",
  "title": "ProductDeactivated",
  "description": "Emitted by the Catalog service when a product is no longer sellable (soft delete / archived). Consumers should hide it from menus and reject new orders for it.",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.v1.ProductDeactivated",
  "required": [
    "eventId",
    "productId",
    "occurredAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "description": "Optional human-readable reason (e.g. DISCONTINUED, OUT_OF_STOCK)."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
