{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hubinity.local/events/v1/OrderPaid.schema.json",
  "title": "OrderPaid",
  "description": "Emitted by the Order service when an order has been successfully paid. Consumed by Cashier (for ledger entry) and Catalog (for stock reservation release).",
  "type": "object",
  "javaType": "com.hubinity.contracts.events.v1.OrderPaid",
  "required": [
    "eventId",
    "orderId",
    "totalAmount",
    "paymentMethod",
    "paidAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance (idempotency key)."
    },
    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of this event schema.",
      "default": "1.0.0"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the paid order."
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0,
      "description": "Total amount paid, in the order's currency."
    },
    "currency": {
      "type": "string",
      "description": "ISO-4217 currency code.",
      "default": "BRL"
    },
    "paymentMethod": {
      "type": "string",
      "enum": ["CASH", "CREDIT_CARD", "DEBIT_CARD", "PIX", "VOUCHER"]
    },
    "transactionId": {
      "type": "string",
      "description": "External PSP transaction id, if any."
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
